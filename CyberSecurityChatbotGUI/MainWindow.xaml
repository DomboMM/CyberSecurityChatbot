<Window x:Class="CyberSecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot"
        Height="650"
        Width="950"
        Background="#1A1A2E">

    <Window.Resources>
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border"
                                Background="#3C1F5C"
                                CornerRadius="10,10,0,0"
                                Margin="2,0"
                                Padding="16,10">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#9C27B0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E91E63"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#F48FB1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#9C27B0" CornerRadius="15" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🔒 CYBERSECURITY AWARENESS CHATBOT"
                           FontSize="22" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Stay Safe Online — Now with Tasks, Quiz &amp; Activity Log"
                           FontSize="13" Foreground="#F8BBD0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">

            <TabItem Header="💬 Chat">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#2E1A47" CornerRadius="15" Padding="10">
                        <ListBox x:Name="ChatList"
                                 Background="#2E1A47"
                                 Foreground="White"
                                 FontSize="14"
                                 BorderThickness="0"/>
                    </Border>

                    <Border Grid.Row="1" Background="#3C1F5C" CornerRadius="15" Padding="10" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="UserInput"
                                     Width="650" Height="35" FontSize="14"
                                     Margin="0,0,10,0"
                                     Background="#F3E5F5" Foreground="Black"
                                     BorderBrush="#CE93D8"
                                     KeyDown="UserInput_KeyDown"/>
                            <Button Content="Send" Width="120" Height="35"
                                    FontWeight="Bold" Background="#E91E63"
                                    Foreground="White" BorderBrush="#F48FB1"
                                    Click="Send_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="✅ Tasks">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#3C1F5C" CornerRadius="15" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Add a New Cybersecurity Task" Foreground="#F8BBD0" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBox x:Name="TaskTitleBox" Background="#F3E5F5" Foreground="Black" Padding="6" Margin="0,0,0,6"/>
                            <TextBox x:Name="TaskDescBox" Background="#F3E5F5" Foreground="Black" Padding="6" Margin="0,0,0,6"
                                     Height="50" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Remind me in (days, optional): " Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="ReminderDaysBox" Width="60" Background="#F3E5F5" Foreground="Black" Padding="4"/>
                            </StackPanel>
                            <Button Content="➕ Add Task" Style="{StaticResource ActionButton}"
                                    HorizontalAlignment="Left" Click="AddTask_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#2E1A47" CornerRadius="15" Padding="10" Margin="0,10,0,10">
                        <ListBox x:Name="TaskList" Background="#2E1A47" Foreground="White" FontSize="13" BorderThickness="0"/>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="✅ Mark Selected Complete" Style="{StaticResource ActionButton}" Click="CompleteTask_Click"/>
                        <Button Content="🗑️ Delete Selected" Style="{StaticResource ActionButton}" Click="DeleteTask_Click"/>
                        <Button Content="🔄 Refresh" Style="{StaticResource ActionButton}" Click="RefreshTasks_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="🎮 Quiz">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#9C27B0" CornerRadius="15" Padding="12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock x:Name="QuizProgressText" Text="Press Start to begin the quiz!"
                                       Foreground="White" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#2E1A47" CornerRadius="15" Padding="20" Margin="0,10,0,10">
                        <StackPanel>
                            <TextBlock x:Name="QuizQuestionText"
                                       Text="Click 'Start Quiz' below to test your cybersecurity knowledge!"
                                       Foreground="White" FontSize="16" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <StackPanel x:Name="QuizOptionsPanel"/>

                            <TextBlock x:Name="QuizFeedbackText"
                                       Foreground="#3DFF91" FontSize="13" FontWeight="Bold"
                                       TextWrapping="Wrap" Margin="0,16,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button x:Name="StartQuizButton" Content="▶ Start Quiz" Style="{StaticResource ActionButton}" Click="StartQuiz_Click"/>
                        <Button x:Name="NextQuestionButton" Content="Next Question ▶" Style="{StaticResource ActionButton}"
                                Click="NextQuestion_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="📋 Activity Log">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#2E1A47" CornerRadius="15" Padding="10">
                        <ListBox x:Name="ActivityLogList" Background="#2E1A47" Foreground="White" FontSize="13" BorderThickness="0"/>
                    </Border>

                    <Button Grid.Row="1" Content="🔄 Refresh Log" Style="{StaticResource ActionButton}"
                            HorizontalAlignment="Left" Margin="0,10,0,0" Click="RefreshLog_Click"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>