<Window x:Class="CyberSecurityChatbotGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot"
        Height="550"
        Width="850"
        Background="#1A1A2E">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="#9C27B0"
                CornerRadius="15"
                Padding="15"
                Margin="0,0,0,10">

            <StackPanel>

                <TextBlock Text="🔒 CYBERSECURITY AWARENESS CHATBOT"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Stay Safe Online"
                           FontSize="15"
                           Foreground="#F8BBD0"
                           HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>

        <!-- Chat Area -->
        <Border Grid.Row="1"
                Background="#2E1A47"
                CornerRadius="15"
                Padding="10">

            <ListBox x:Name="ChatList"
                     Background="#2E1A47"
                     Foreground="White"
                     FontSize="15"
                     BorderThickness="0"/>
        </Border>

        <!-- Input Area -->
        <Border Grid.Row="2"
                Background="#3C1F5C"
                CornerRadius="15"
                Padding="10"
                Margin="0,10,0,0">

            <StackPanel Orientation="Horizontal">

                <TextBox x:Name="UserInput"
                         Width="620"
                         Height="35"
                         FontSize="14"
                         Margin="0,0,10,0"
                         Background="#F3E5F5"
                         Foreground="Black"
                         BorderBrush="#CE93D8"/>

                <Button Content="Send"
                        Width="150"
                        Height="35"
                        FontWeight="Bold"
                        Background="#E91E63"
                        Foreground="White"
                        BorderBrush="#F48FB1"
                        Click="Send_Click"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>